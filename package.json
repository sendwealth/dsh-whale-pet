{
  "name": "@local/whale-pet",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "DeepSeek whale-girl desktop pet for the Harness Web UI",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./whale-girl-small.png"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "whale-girl-small.png"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
